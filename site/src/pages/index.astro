---
import '../styles/global.css';
import gallery from '../generated/gallery.json';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const assetUrl = (path) => `${base}${path.split('/').map(encodeURIComponent).join('/')}`;
const categoryIcons = { character: 'type-icon-character.png', accessory: 'type-icon-accessory.png', emote: 'type-icon-emote.png' };
const initialCategory = gallery.categories[0];
const initialGroup = initialCategory.groups[0];
const initialEntries = initialCategory.entries.filter((entry) => entry.group === initialGroup);
const json = JSON.stringify(gallery).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="zh-CN" data-base={base} style={`--atlas-card: url("${assetUrl('assets/界面/原版/atlas-item-bg.png')}")`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Wuwa Tappo 素材归档：浏览角色、配件、表情与界面素材。" />
    <meta name="color-scheme" content="light dark" />
    <title>素材图鉴 · Wuwa Tappo</title>
    <link rel="icon" type="image/png" href={assetUrl('assets/图标/发行包/favicon.png')} />
    <style is:inline set:html={`@font-face { font-family: Tappo; src: url("${assetUrl('assets/字体/975MaruSC-Medium-CqkJPt5f.woff2')}") format("woff2"); font-weight: 400 600; font-display: swap; } @font-face { font-family: Tappo; src: url("${assetUrl('assets/字体/975MaruSC-Bold-iviPgHHc.woff2')}") format("woff2"); font-weight: 700 900; font-display: swap; }`} />
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('wuwa-gallery-theme');
        const theme = savedTheme === 'light' || savedTheme === 'dark'
          ? savedTheme
          : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      } catch {
        document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
    </script>
  </head>
  <body>
    <header class="topbar">
      <a href={base} class="brand" aria-label="Wuwa Tappo 素材图鉴首页">
        <img class="brand-logo" src={assetUrl('assets/界面/原版/logo.png')} alt="Wuwa Tappo" />
        <span class="brand-caption" data-i18n="素材图鉴">素材图鉴</span>
      </a>
      <div class="topbar-actions">
        <a class="repo-link" href="https://github.com/lliooly/wuwa-tappo-assets" target="_blank" rel="noreferrer" aria-label="查看源码" title="查看源码" data-i18n-label="查看源码"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.71 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.29-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.29-.5-1.43.11-2.98 0 0 .95-.3 3.08 1.15A10.7 10.7 0 0 1 12 6.12c.95 0 1.9.13 2.8.38 2.14-1.45 3.08-1.15 3.08-1.15.61 1.55.23 2.69.12 2.98.72.79 1.15 1.79 1.15 3.02 0 4.32-2.64 5.27-5.15 5.55.4.35.76 1.03.76 2.08v3.11c0 .3.21.65.78.54A11.2 11.2 0 0 0 12 .8Z" /></svg></a>
        <button id="language-toggle" class="language-toggle" type="button" aria-label="切换语言">中文</button>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="切换深浅色模式" title="切换深浅色模式">
          <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="3.7"></circle><path d="M12 2v2.1M12 19.9V22M4.93 4.93l1.49 1.49m11.16 11.16 1.49 1.49M2 12h2.1M19.9 12H22M4.93 19.07l1.49-1.49M17.58 6.42l1.49-1.49"></path></svg>
          <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.3 15.5A8.8 8.8 0 0 1 8.5 3.7a8.8 8.8 0 1 0 11.8 11.8Z"></path></svg>
        </button>
      </div>
    </header>

    <main class="shell">
      <div class="workspace">
        <aside class="sidebar" aria-label="素材分类">
          <div class="sidebar-heading"><span data-i18n="分类">分类</span></div>
          <nav id="categories" class="category-list" aria-label="素材分类">
            {gallery.categories.map((category, index) => (
              <button type="button" class:list={['category', { active: index === 0 }]} data-category={category.id} aria-pressed={index === 0 ? 'true' : 'false'}>
                <span class="category-symbol">{categoryIcons[category.id] ? <img src={assetUrl(`assets/界面/原版/${categoryIcons[category.id]}`)} alt="" /> : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {category.id === 'interface' && <><rect x="3" y="4" width="18" height="16" rx="4" /><path d="M3 10h18M9 10v10" /></>}
                  {category.id === 'icon' && <><rect x="4" y="4" width="16" height="16" rx="5" /><path d="m12 7 1.5 3.5L17 12l-3.5 1.5L12 17l-1.5-3.5L7 12l3.5-1.5Z" /></>}
                  {category.id === 'font' && <><path d="M4 6h16M12 6v14M8 20h8M4 6v3M20 6v3" /></>}
                </svg>}</span>
                <span class="category-label">{category.label}</span>
                <span class="category-count">{category.entries.length}</span>
                <span class="category-arrow" aria-hidden="true">↗</span>
              </button>
            ))}
          </nav>
        </aside>

        <section class="collection" aria-labelledby="collection-title">
          <div class="collection-heading">
            <div><h2 id="collection-title">角色</h2></div>
            <label class="search-box" for="search">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.4"></circle><path d="m15.5 15.5 4.3 4.3"></path></svg>
              <input id="search" type="search" aria-label="搜索名称或文件名" placeholder="搜索名称或文件名" autocomplete="off" />
              <kbd>/</kbd>
            </label>
          </div>
          <div class="filter-row">
            <div id="groups" class="group-list" aria-label="素材类型">
              {initialCategory.groups.map((group, index) => <button type="button" class:list={['group', { active: index === 0 }]} data-group={group} aria-pressed={index === 0 ? 'true' : 'false'}>{group}</button>)}
            </div>
            <p class="result-count"><span id="result-count">{initialEntries.length}</span> <span data-i18n="项">项</span></p>
          </div>
          <div id="gallery" class="gallery" aria-live="polite">
            {initialEntries.map((entry) => (
              <button type="button" class="asset-card" data-entry-id={entry.id} aria-label={`查看 ${entry.name}`}>
                <span class="asset-image"><img src={assetUrl(entry.path)} alt="" loading="lazy" decoding="async" /></span>
                <span class="asset-text"><span class="asset-name">{entry.name}</span><span class="asset-filename">{entry.filename}</span></span>
              </button>
            ))}
          </div>
          <p id="empty-state" class="empty-state" hidden data-i18n="没有找到相关素材。">没有找到相关素材。</p>
          <noscript><p class="empty-state">启用 JavaScript 后可搜索和切换分类。</p></noscript>
        </section>
      </div>
    </main>
    <footer class="footer"><span data-i18n="素材归档">素材归档</span><a href="https://github.com/lliooly/wuwa-tappo-assets/blob/main/docs/%E7%89%88%E6%9D%83%E4%B8%8E%E6%9D%A5%E6%BA%90.md" target="_blank" rel="noreferrer" data-i18n="非官方素材归档 · 权利与来源">非官方素材归档 · 权利与来源 ↗</a></footer>

    <dialog id="detail-dialog" aria-labelledby="detail-title">
      <div class="dialog-content">
        <button id="detail-close" class="dialog-close" type="button" aria-label="关闭" data-i18n-label="关闭">×</button>
        <div id="detail-preview" class="detail-preview"><img id="detail-image" alt="" /><span id="detail-font" hidden>Aa 字</span></div>
        <div class="detail-body">
          <p id="detail-category" class="section-kicker"></p>
          <h2 id="detail-title"></h2>
          <p id="detail-alias" class="detail-alias" hidden></p>
          <div class="path-label"><span data-i18n="仓库路径">仓库路径</span> <span id="detail-dimensions"></span></div>
          <code id="detail-path"></code>
          <div class="detail-actions"><button id="copy-path" class="primary-action" type="button" data-i18n="复制路径">复制路径</button><a id="open-asset" class="secondary-action" target="_blank" rel="noreferrer" data-i18n="打开原文件">打开原文件 ↗</a></div>
          <div id="related-wrap" class="related-wrap" hidden><p class="path-label" data-i18n="同一条目的其他素材">同一条目的其他素材</p><div id="related-files" class="related-files"></div></div>
        </div>
      </div>
    </dialog>
    <script id="gallery-data" type="application/json" set:html={json}></script>
    <script>import '../scripts/gallery.js';</script>
  </body>
</html>
